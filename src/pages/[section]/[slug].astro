---
// Individual post pages — minimal layout: back link, title, tags, cover
// image, body, gallery. No header/nav/footer, for distraction-free reading.
import { getCollection, render } from 'astro:content';
import MinimalLayout from '../../layouts/MinimalLayout.astro';
import CoverImage from '../../components/CoverImage.astro';
import Gallery from '../../components/Gallery.astro';
import { SECTIONS } from '../../config';
import { excerptFrom } from '../../utils';

export async function getStaticPaths() {
  const paths = [];
  for (const section of SECTIONS) {
    const entries = await getCollection(section.key);
    for (const entry of entries) {
      paths.push({
        params: { section: section.key, slug: entry.id },
        props: { section, entry },
      });
    }
  }
  return paths;
}

const { section, entry } = Astro.props;
const { Content } = await render(entry);
const excerpt = entry.data.excerpt || excerptFrom(entry.body ?? '');
---
<MinimalLayout title={entry.data.title} description={excerpt}>
  <article class="post">
    <p class="post-back"><a href={`/${section.key}/`}>← Back to {section.label}</a></p>
    <h1>{entry.data.title}</h1>
    {entry.data.tags && entry.data.tags.length > 0 && (
      <p class="post-tags">{entry.data.tags.join(' · ')}</p>
    )}
    <CoverImage cover={entry.data.cover} coverAlt={entry.data.coverAlt} coverCaption={entry.data.coverCaption} title={entry.data.title} />
    <div class="post-body">
      <Content />
    </div>
    <Gallery gallery={entry.data.gallery} title={entry.data.title} />
  </article>
</MinimalLayout>
