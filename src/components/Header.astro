---
import fs from 'node:fs';
import { SECTIONS, SITE } from '../config';

interface Props {
  active?: string;
}
const { active } = Astro.props as Props;

// Logo is picked up automatically the moment public/logo.png exists —
// nothing else to wire up. Drop it in and rebuild.
const HAS_LOGO = fs.existsSync(new URL('../../public/logo.png', import.meta.url));
---
<header class="site-header">
  <a class="logo" href="/">
    {HAS_LOGO
      ? <img src="/logo.svg" alt={SITE.name} height="56" class="logo-img" />
      : SITE.name}
  </a>
  <nav>
    {SECTIONS.map((s) => (
      <a href={`/${s.key}/`} class={active === s.key ? 'active' : ''}>{s.label}</a>
    ))}
    <a href="/about/" class={active === 'about' ? 'active' : ''}>About</a>
    <a href="/contact/" class={active === 'contact' ? 'active' : ''}>Contact</a>
  </nav>
</header>
